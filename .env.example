# ---------------------------------------------------------------
# WorldTakeCare API — environment template
# Copy to `.env` and fill in values. Never commit `.env`.
# Do NOT copy any credential from the legacy PHP source.
# ---------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000

# Comma-separated list of browser origins allowed by CORS (required)
CORS_ORIGINS=http://localhost:3000

# Swagger UI at /api/docs (defaults: on in development, off in production)
API_DOCS_ENABLED=true

# morgan log format: dev | combined | common | short | tiny
LOG_FORMAT=dev

# Max accepted JSON body size
JSON_BODY_LIMIT=1mb

# Set to the number of proxy hops (e.g. 1) when running behind a load balancer
TRUST_PROXY=false

# Graceful shutdown timeout in milliseconds
SHUTDOWN_TIMEOUT_MS=10000

# ---------------------------------------------------------------
# Reserved for later phases — NOT read by the app yet.
# Added here so the team can see what will be needed.
# ---------------------------------------------------------------
# DATABASE_URL=
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=
# RECAPTCHA_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# APPLE_SERVICES_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# VIDEOSDK_API_KEY=
# VIDEOSDK_SECRET=
# IPINFO_TOKEN=
# MEDIA_STORAGE_DRIVER=
