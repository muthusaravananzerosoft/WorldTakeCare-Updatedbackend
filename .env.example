# ---------------------------------------------------------------
# WorldTaker API — environment template
# Copy to `.env` and fill in values. Never commit `.env`.
# Do NOT copy any credential from the legacy PHP source.
# ---------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000

# Comma-separated list of browser origins allowed by CORS (required)
CORS_ORIGINS=http://localhost:3000

# Swagger UI at /api/docs (defaults: on in development, off in production)
API_DOCS_ENABLED=true

# morgan log format: dev | combined | common | short | tiny
LOG_FORMAT=dev

# Max accepted JSON body size
JSON_BODY_LIMIT=1mb

# Set to the number of proxy hops (e.g. 1) when running behind a load balancer
TRUST_PROXY=false

# Graceful shutdown timeout in milliseconds
SHUTDOWN_TIMEOUT_MS=10000

# API rate limit: max requests per IP per window
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Uploads: per-file size cap in MB
UPLOAD_MAX_FILE_SIZE_MB=10
MEDIA_STORAGE_DIR=uploads

# Database connection (mysql2). Omit to run the API without a database.
DATABASE_URL=mysql://root@localhost:3306/worldtakecare
DATABASE_POOL_SIZE=10

# Auth tokens — JWT_ACCESS_SECRET must be a strong random value in production.
# ACCESS_TOKEN_TTL_MIN: minutes until an access token expires (0 = never expires).
JWT_ACCESS_SECRET=dev-only-secret-change-me-0123456789
ACCESS_TOKEN_TTL_MIN=0
REFRESH_TOKEN_TTL_DAYS=30
APP_BASE_URL=http://localhost:4000
# Frontend site base URL — activation/reset email links open the web app's
# pages, which then call this API (set to the frontend domain in production).
WEB_APP_URL=http://localhost:3000

# Outbound mail — leave SMTP_HOST empty for dev (mails print to the server console).
# Fill these in to send real email (Mailtrap, SendGrid SMTP, Gmail app password, hosting SMTP...).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="WorldTaker <no-reply@worldtaker.local>"

# ---------------------------------------------------------------
# Reserved for later phases — NOT read by the app yet.
# Added here so the team can see what will be needed.
# ---------------------------------------------------------------
